# ── Virtual environment ───────────────────────────────────────────────────────
venv/
.venv/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Uploads (runtime data, mounted via volume or cloud storage) ────────────────
uploads/

