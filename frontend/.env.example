# ─────────────────────────────────────────────────────────────────────────────
# Revenue Leak Radar — Frontend environment template
# Copy to .env.local for local development, or set in Vercel dashboard.
# NEVER commit real values to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API URL (production only) ─────────────────────────────────────────────────
# In production (Vercel), set this to your Render backend URL + /api:
# VITE_API_URL=https://your-revenue-radar-api.onrender.com/api
#
# Leave UNSET for local development — the Vite dev proxy handles /api routing.
VITE_API_URL=

# ── Dev proxy override (local development only) ───────────────────────────────
# Only needed if your local backend runs on a non-standard port:
# VITE_BACKEND_DEV_URL=http://localhost:8000
VITE_BACKEND_DEV_URL=
