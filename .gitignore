# ─────────────────────────────────────────────────────────────────────────────
# Revenue Leak Radar — Root .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets / Environment ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ── Database files (local only — do NOT commit to git) ───────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# Backup files created during migrations
*.db.bak_*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
*.pyc
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
backend/venv/
backend/.venv/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── File uploads (user data — never commit) ───────────────────────────────────
uploads/
backend/uploads/
*.csv
*.xlsx
*.xls

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Dev scripts (not needed in production) ────────────────────────────────────
# fix_pipeline.py is kept for historical reference.
# Exclude scratch/temp artifacts:
0
